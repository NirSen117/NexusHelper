APP_ENV=development
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=nexushelper
FALKORDB_USE_TLS=false
DEMO_AUTH_ENABLED=true
# JSON object of local-only users and server-controlled team scopes.
# Example: {"alice":["team-platform"],"bob":["team-support","team-platform"]}
DEMO_PRINCIPALS={"emp-alice":["team-platform"],"emp-bob":["team-payments"],"emp-carol":["team-security"]}
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
# Set GOOGLE_APPLICATION_CREDENTIALS outside the repository when using a
# service-account file, or use Google Application Default Credentials.
MODEL_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MODEL_TIMEOUT_SECONDS=25
PROFILE_STORE=local
FIRESTORE_PROJECT_ID=
FIRESTORE_PROFILES_COLLECTION=nexushelper_profiles
FIRESTORE_MEMBERSHIPS_COLLECTION=nexushelper_memberships
FRONTEND_ORIGIN=http://localhost:5173
